{
  "name": "speakkit",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "vp test run",
    "e2e": "node e2e/run.mjs",
    "e2e:full": "node e2e/run.mjs --full",
    "knip": "node scripts/check-knip.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:css": "node scripts/check-css.mjs",
    "check:network": "node scripts/check-network.mjs",
    "check:integrity": "node scripts/check-integrity.mjs",
    "ratchet": "node scripts/check-ratchet.mjs",
    "mutate": "stryker run",
    "mutate:capture": "stryker run stryker.capture.config.json",
    "gates": "node scripts/check-deps.mjs && node scripts/check-css.mjs && node scripts/check-network.mjs && node scripts/check-integrity.mjs && node scripts/check-ratchet.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.4.1"
}
