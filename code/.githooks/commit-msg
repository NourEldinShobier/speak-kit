#!/bin/sh
# Conventional Commits check; enable with: git config core.hooksPath .githooks
msg=$(head -n1 "$1")
echo "$msg" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+' || {
  echo "commit message must follow Conventional Commits, e.g. feat(player): add seek" >&2
  exit 1
}
