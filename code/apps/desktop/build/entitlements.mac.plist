<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 compiles JavaScript to machine code at run time. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The speech and voice engines load native add-ons (whisper.cpp, onnxruntime, koffi) that are not signed by the app's own team. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Dictation records the microphone. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Reading a selection presses Cmd+C through System Events. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
