{
  "lint": {
    "code": {
      "no-sync": 14,
      "complexity": 2,
      "max-lines-per-function": 2,
      "max-params": 2,
      "no-nested-ternary": 1
    },
    "tests": {
      "no-explicit-any": 3
    }
  },
  "patterns": {
    "asAny": 0,
    "asUnknownAs": 0,
    "tsDirective": 0,
    "atomicsWait": 0,
    "sendSync": 0,
    "shortInterval": 0,
    "oxlintDisable": 0,
    "swallowingCatch": 4,
    "physicalCss": 0,
    "skipped": 2,
    "focused": 0,
    "tsNocheck": 0
  }
}
