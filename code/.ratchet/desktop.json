{
  "lint": {
    "code": {
      "max-lines-per-function": 16,
      "no-nested-ternary": 13,
      "max-params": 14,
      "exhaustive-deps": 1,
      "complexity": 7
    },
    "tests": {
      "no-explicit-any": 5
    }
  },
  "patterns": {
    "asAny": 0,
    "asUnknownAs": 9,
    "tsDirective": 0,
    "atomicsWait": 0,
    "sendSync": 0,
    "shortInterval": 0,
    "oxlintDisable": 0,
    "swallowingCatch": 10,
    "physicalCss": 1,
    "skipped": 0,
    "focused": 0,
    "tsNocheck": 0
  }
}
