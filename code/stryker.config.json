{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.stryker.config.ts", "related": false },
  "mutate": [
    "packages/dictation/src/**/*.ts",
    "packages/transcripts/src/**/*.ts",
    "!packages/transcripts/src/fs.ts",
    "packages/engine/src/stt/{languages,download-error,transfers,device,hardware,idle,switching,model-files,compare,recommend}.ts",
    "apps/desktop/src/main/speech-models/{view,hardware-probe,layout}.ts",
    "apps/desktop/src/main/{mic-owners,dictation/chord-tracker,dictation/pause-rules}.ts",
    "apps/desktop/src/main/dictation/macos/{hook,mouse-button}.ts",
    "packages/engine/src/host-port.ts",
    "apps/desktop/src/renderer/speech-text.ts",
    "apps/desktop/src/renderer/features/wizard/dictation-step.ts",
    "apps/desktop/src/shared/dictation/sounds.ts",
    "apps/desktop/src/main/dictation/{hud-place,transform-typed,spool,spooled-recorder,fixture-recorder,app-profile,program-version}.ts",
    "apps/desktop/src/main/dictation/ducking/{windows-audio,mac-audio,index}.ts",
    "packages/meetings/src/**/*.ts",
    "!packages/meetings/src/index.ts",
    "!packages/meetings/src/pure.ts",
    "!packages/meetings/src/types.ts"
  ],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "tempDirName": "node_modules/.stryker-tmp",
  "thresholds": { "high": 90, "low": 75, "break": 70 },
  "timeoutMS": 10000,
  "concurrency": 4,
  "ignoreStatic": false
}
